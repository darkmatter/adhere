{
  "name": "@drkmttr/adhere",
  "version": "0.15.0",
  "private": false,
  "description": "Lints a repository against the rules in .adhere/, judged by Jev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkmatter/adhere.git"
  },
  "bin": {
    "adhere": "bin/adhere.js"
  },
  "files": [
    "bin",
    "src",
    "presets",
    "skills"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "vp lint --deny-warnings .",
    "start": "bun src/main.ts",
    "test": "vp test",
    "typecheck": "tsc --noEmit && bun run lint",
    "build": "bun build --compile --minify --sourcemap --define ADHERE_BUILD=\"\\\"$(git describe --tags --dirty --always)\\\"\" src/main.ts --asset ./presets --outfile dist/adhere",
    "build:npm": "bun scripts/npm-packages.ts build",
    "release": "release-it",
    "prepare": "vp config"
  },
  "dependencies": {
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.118",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.0.0",
    "release-it": "^21.1.0",
    "typescript": "7.1.0-dev.20261009.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.118",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@21.1.0/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main",
      "tag": false
    },
    "github": {
      "autoGenerate": true,
      "release": true
    },
    "npm": {
      "allowSameVersion": true,
      "publish": false
    }
  }
}
