---
// A recorded `adhere rules create` session with a button per step. `at` is where each step
// starts, in seconds of playback after the cast's 3-second idle limit compresses pauses.
import "asciinema-player/dist/bundle/asciinema-player.css";

const steps = [
  { at: 0, title: "Describe the rule" },
  { at: 46.3, title: "Judge real code" },
  { at: 73.1, title: "Trial the draft" },
  { at: 88.3, title: "Review the findings" },
  { at: 99.7, title: "Revise and push" },
];
---

<div class="walkthrough not-content">
  <ol class="steps">
    {
      steps.map((step, index) => (
        <li>
          <button
            type="button"
            data-at={step.at}
            data-title={step.title}
            aria-current={index === 0 ? "step" : "false"}
          >
            <span class="number">{index + 1}</span>
            {step.title}
          </button>
        </li>
      ))
    }
  </ol>
  <div class="screen" data-cast="/adhere/adhere-rules-create.cast"></div>
</div>

<script>
  import * as AsciinemaPlayer from "asciinema-player";

  const screen = document.querySelector<HTMLElement>(".walkthrough .screen");
  const steps = [...document.querySelectorAll<HTMLButtonElement>(".walkthrough [data-at]")].map(
    (button) => ({ button, start: Number(button.dataset.at), title: button.dataset.title ?? "" }),
  );

  if (screen?.dataset.cast) {
    const player = AsciinemaPlayer.create(screen.dataset.cast, screen, {
      // The recording's size; set up front so the player doesn't resize when the cast loads.
      cols: 120,
      rows: 60,
      fit: "width",
      poster: "npt:0:20",
      terminalLineHeight: 1.3,
      terminalFontSize: "18px",
      markers: steps.map(({ start, title }): [number, string] => [start, title]),
    });
    // The player emits no event when its timeline is scrubbed or it jumps between markers,
    // so the active step follows its clock.
    let current = 0;
    setInterval(() => {
      const time = player.getCurrentTime();
      const index = Math.max(0, steps.findLastIndex(({ start }) => start <= time));
      if (index === current) return;
      current = index;
      for (const [i, { button }] of steps.entries()) {
        button.setAttribute("aria-current", i === index ? "step" : "false");
      }
    }, 250);
    for (const { button, start } of steps) {
      button.addEventListener("click", async () => {
        await player.seek(start);
        await player.play();
      });
    }
  }
</script>

<style>
  .walkthrough {
    margin-block: 1.5rem;
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .steps button {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font: inherit;
    font-size: 0.875rem;
    color: var(--dm-muted-foreground);
    background: transparent;
    border: 1px solid var(--dm-border);
    border-radius: 999px;
    cursor: pointer;
  }
  .steps button[aria-current="step"] {
    color: var(--dm-zinc-200);
    border-color: var(--dm-mint);
    background: var(--dm-card);
  }
  .number {
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--dm-mint);
  }
  .screen {
    border: 1px solid var(--dm-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }
</style>
