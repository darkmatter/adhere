<style>
  .finding {
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--dm-zinc-300);
    background: var(--dm-card);
  }
  .finding :global(.err) {
    color: oklch(70% 0.19 25);
  }
  .finding :global(.ok),
  .finding :global(.mark) {
    color: var(--dm-mint);
  }
  .finding :global(.dim) {
    color: var(--dm-muted-foreground);
  }
  .finding :global(.path) {
    color: var(--dm-mint-light);
  }
  .finding :global(.hint) {
