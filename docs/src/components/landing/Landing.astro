---
// The landing page: the pitch, the install command, and a real finding.
import Finding from "./Finding.astro";
---

<section class="a not-content">
  <p class="eyebrow">powered by TypeSafe AI</p>
  <h2 class="headline">Lint the rules your linter can't.</h2>
  <p class="sub">
    Write a rule in Markdown, with code that shows it. adhere asks Jev whether each file breaks
    it, and reports what Jev is confident about, in a report that reads like Oxlint's.
  </p>

  <div class="install">
    <code>npm install -D @drkmttr/adhere</code>
    <button type="button" data-copy="npm install -D @drkmttr/adhere">copy</button>
  </div>

  <div class="actions">
    <a class="primary" href="/adhere/getting-started/">Get started →</a>
    <a class="ghost" href="https://github.com/darkmatter/adhere">GitHub</a>
  </div>

  <div class="window">
    <div class="bar">
      <span></span><span></span><span></span>
      <code>$ npx @drkmttr/adhere lint</code>
    </div>
    <Finding />
  </div>

  <ul class="facts">
    <li>
      <strong>Rules are prose.</strong>
      “Business logic lives in services.” One sentence, plus code under
      <code>## Must</code> and <code>## Never</code>.
    </li>
    <li>
      <strong>Scores, not guesses.</strong>
      Jev answers with a calibrated probability. Only findings above the threshold are reported.
    </li>
    <li>
      <strong>CI pays for the diff.</strong>
      Judgments are cached by file and rule text. Commit the cache; unchanged files cost nothing.
    </li>
  </ul>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".a [data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "copied";
      setTimeout(() => (button.textContent = "copy"), 1200);
    });
  }
</script>

<style>
  .a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 4rem 2rem;
  }
  .eyebrow {
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dm-muted-foreground);
  }
  .headline {
    margin-top: 1rem;
    font-family: "Montserrat Variable", var(--__sl-font);
    font-weight: 900;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--dm-foreground);
  }
  .sub {
    max-width: 38rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--dm-muted-foreground);
  }
  .install {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0.625rem 0.75rem 0.625rem 1.25rem;
    border: 1px solid var(--dm-border);
    border-radius: 999px;
    background: var(--dm-card);
  }
  .install code {
    font-family: var(--__sl-font-mono);
    color: var(--dm-zinc-200);
  }
  .install code::before {
    content: "$ ";
    color: var(--dm-mint);
  }
  .install button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--dm-border);
    border-radius: 999px;
    background: transparent;
    color: var(--dm-muted-foreground);
    cursor: pointer;
  }
  .actions {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .actions a {
    text-decoration: none;
    font-weight: 500;
  }
  .primary {
    color: var(--dm-mint);
  }
  .ghost {
    color: var(--dm-muted-foreground);
  }
  .window {
    width: 100%;
    margin-top: 4rem;
    text-align: left;
    border: 1px solid var(--dm-border);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 0 80px -20px color-mix(in oklch, var(--dm-mint) 35%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--dm-border);
    background: var(--dm-card);
  }
  .bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--dm-border);
  }
  .bar code {
    margin-left: 0.75rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: var(--dm-muted-foreground);
  }
  .facts {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 4rem;
    padding: 0;
    list-style: none;
    text-align: left;
    color: var(--dm-muted-foreground);
  }
  .facts strong {
    display: block;
    margin-bottom: 0.375rem;
    color: var(--dm-zinc-200);
  }
  .facts code {
    font-family: var(--__sl-font-mono);
    font-size: 0.85em;
    color: var(--dm-mint);
  }
</style>

<style is:global>
  /* The landing brings its own headline: drop the page title panel, widen the page. */
  main:has(.a) {
    --sl-content-width: 72rem;
  }
  main:has(.a) > .content-panel:first-of-type {
    display: none;
  }
  main:has(.a) > .content-panel + .content-panel {
    border-top: 0;
  }
</style>
