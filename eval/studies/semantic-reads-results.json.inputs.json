  "cases": [
    {
      "name": "timeout-1",
      "family": "timeout",
      "rule": "typescript/async/network-calls-have-timeouts",
      "variant": "checked",
      "label": "false",
      "note": "The judged request receives a finite AbortSignal timeout from settings().",
      "files": {
        "subject.ts": "import { settings } from \"./neighbor\";\nexport async function loadRemote() {\n  return await fetch(\"https://billing.example.invalid/invoices\", settings());\n}\n",
        "neighbor.ts": "export function settings(): RequestInit {\n  return { signal: AbortSignal.timeout(5_000) };\n}\n"
      }
    },
    {
      "name": "timeout-2",
      "family": "timeout",
      "rule": "typescript/async/network-calls-have-timeouts",
      "variant": "unchecked",
      "label": "real",
      "note": "settings() supplies no timeout or signal for the judged third-party request.",
      "files": {
        "subject.ts": "import { settings } from \"./neighbor\";\nexport async function loadRemote() {\n  return await fetch(\"https://billing.example.invalid/invoices\", settings());\n}\n",
        "neighbor.ts": "export function settings(): RequestInit {\n  return {};\n}\n"
      }
    },
    {
      "name": "timeout-3",
      "family": "timeout",
      "rule": "typescript/async/network-calls-have-timeouts",
      "variant": "control",
      "label": "false",
      "note": "The judged request remains bounded; an unrelated request in the helper file is not its violation.",
      "files": {
        "subject.ts": "import { settings } from \"./neighbor\";\nexport async function loadRemote() {\n  return await fetch(\"https://billing.example.invalid/invoices\", settings());\n}\n",
        "neighbor.ts": "export function settings(): RequestInit {\n  return { signal: AbortSignal.timeout(5_000) };\n}\nexport async function loadCatalog() {\n  return await fetch(\"https://billing.example.invalid/catalog\");\n}\n"
      }
    },
    {
      "name": "validation-1",
      "family": "validation",
      "rule": "typescript/types/validate-external-data",
      "variant": "checked",
      "label": "false",
      "note": "The guard checks both fields before the target assigns external data a declared type.",
      "files": {
        "subject.ts": "import { inspect } from \"./neighbor\";\nexport async function readRecord(request: Request) {\n  const raw: unknown = await request.json();\n  if (!inspect(raw)) throw new TypeError(\"Invalid record\");\n  const record: { id: string; email: string } = raw;\n  return record;\n}\n",
        "neighbor.ts": "export function inspect(value: unknown): value is { id: string; email: string } {\n  return typeof value === \"object\" && value !== null &&\n    \"id\" in value && typeof value.id === \"string\" &&\n    \"email\" in value && typeof value.email === \"string\";\n}\n"
      }
    },
    {
      "name": "validation-2",
      "family": "validation",
      "rule": "typescript/types/validate-external-data",
      "variant": "unchecked",
      "label": "real",
      "note": "The predicate claims a type but performs no runtime validation; the target trusts unvalidated JSON.",
      "files": {
        "subject.ts": "import { inspect } from \"./neighbor\";\nexport async function readRecord(request: Request) {\n  const raw: unknown = await request.json();\n  if (!inspect(raw)) throw new TypeError(\"Invalid record\");\n  const record: { id: string; email: string } = raw;\n  return record;\n}\n",
        "neighbor.ts": "export function inspect(value: unknown): value is { id: string; email: string } {\n  return true;\n}\n"
      }
    },
    {
      "name": "validation-3",
      "family": "validation",
      "rule": "typescript/types/validate-external-data",
      "variant": "control",
      "label": "false",
      "note": "The target still uses the complete guard; another function's unchecked cast is not a target violation.",
      "files": {
        "subject.ts": "import { inspect } from \"./neighbor\";\nexport async function readRecord(request: Request) {\n  const raw: unknown = await request.json();\n  if (!inspect(raw)) throw new TypeError(\"Invalid record\");\n  const record: { id: string; email: string } = raw;\n  return record;\n}\n",
        "neighbor.ts": "export function inspect(value: unknown): value is { id: string; email: string } {\n  return typeof value === \"object\" && value !== null &&\n    \"id\" in value && typeof value.id === \"string\" &&\n    \"email\" in value && typeof value.email === \"string\";\n}\nexport async function readSummary(request: Request) {\n  return (await request.json()) as { id: string; email: string };\n}\n"
      }
    },
    {
