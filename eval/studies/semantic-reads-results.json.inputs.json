        "subject.ts": "export function emit(value: string) {\n  console.info(\"value\", value);\n}\n",
        "neighbor.ts": "import { emit } from \"./subject\";\nexport function handle(request: Request) {\n  const selected = request.headers.get(\"authorization\") ?? \"\";\n  emit(selected);\n}\n"
      }
    },
    {
      "name": "logging-3",
      "family": "logging",
      "rule": "security/no-secrets-in-output",
      "variant": "control",
      "label": "false",
      "note": "The target logs only a public request ID; the separate credential log belongs to another function.",
      "files": {
        "subject.ts": "export function emit(value: string) {\n  console.info(\"value\", value);\n}\n",
        "neighbor.ts": "import { emit } from \"./subject\";\nexport function handle(request: Request) {\n  const selected = request.headers.get(\"x-request-id\") ?? \"\";\n  emit(selected);\n}\nexport function audit(request: Request) {\n  console.info(\"authorization\", request.headers.get(\"authorization\"));\n}\n"
      }
    },
