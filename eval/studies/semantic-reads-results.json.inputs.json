  "rules": {
    "typescript/async/network-calls-have-timeouts": {
      "description": "An HTTP request, such as a `fetch` or a call through an HTTP client, should carry a timeout or an AbortSignal that ends it, and should not wait without limit.",
      "level": "warning",
      "excludeIf": [
        "a call through a client configured with a default timeout",
        "a call whose signal the caller passes in",
        "a request from browser code to the app's own API"
      ],
      "should": "const response = await fetch(`${BILLING_URL}/invoices/${id}`, {\n  signal: AbortSignal.timeout(5_000),\n});",
      "shouldNot": "const response = await fetch(`${BILLING_URL}/invoices/${id}`);"
    },
    "typescript/types/validate-external-data": {
      "description": "Data from outside the program, such as a parsed request body, a fetch response, a file's contents, a message, or an environment variable, must be checked at runtime before code gives it a type, never cast with `as` or assigned from `any` to a declared type. A schema's parse or decode, such as Zod's or Effect Schema's, or a type guard that checks each field it claims, is a runtime check.",
      "appliesTo": [
        "code that reads data from outside the program"
      ],
      "excludeIf": [
        "a value read through a typed client of the program's own database"
      ],
      "must": "const User = z.object({ id: z.string(), email: z.string().email() });\n\nconst response = await fetch(`/api/users/${id}`);\nconst user = User.parse(await response.json());",
      "never": "const response = await fetch(`/api/users/${id}`);\nconst user = (await response.json()) as User;"
    },
    "security/no-secrets-in-output": {
      "description": "A secret, such as a password, an API key, a token, a private key, a session id, or a connection string with credentials, must never be written to a log, put in an error message, or returned in an HTTP response; code must refer to a secret only by its name, its presence, or a non-secret id.",
      "appliesTo": [
        "code that writes a log, builds an error message, or builds an HTTP response"
      ],
      "excludeIf": [
        "a masked secret that shows at most a few of its characters"
      ],
      "must": "logger.info(\"calling billing\", { keyId: apiKey.id });\nthrow new Error(`Could not connect to the database at ${dbHost}`);",
      "never": "logger.info(`calling billing with key ${apiKey.secret}`);\nthrow new Error(`Could not connect to ${process.env.DATABASE_URL}`);"
    },
    "security/constant-time-secret-compare": {
      "description": "Code that checks a secret it received, such as a token, an API key, or an HMAC signature, must compare it in constant time, as `crypto.timingSafeEqual` or a library's verify function does, never with `===`, `!==`, or a string method.",
      "must": "const expected = createHmac(\"sha256\", WEBHOOK_SECRET).update(body).digest();\nconst received = Buffer.from(request.headers.get(\"x-signature\") ?? \"\", \"hex\");\nif (received.length !== expected.length || !timingSafeEqual(received, expected)) {\n  return new Response(\"Invalid signature\", { status: 401 });\n}",
      "never": "const expected = createHmac(\"sha256\", WEBHOOK_SECRET).update(body).digest(\"hex\");\nif (request.headers.get(\"x-signature\") !== expected) {\n  return new Response(\"Invalid signature\", { status: 401 });\n}"
    }
  },
